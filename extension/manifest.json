{
  "manifest_version": 3,
  "name": "Aks Online Meet Sayacı",
  "version": "1.3.0",
  "description": "Meet odasındaki kişi sayısını Aks Online paneline iletir. Karşıdan biri girince sayaç başlar, çıkınca durur.",
  "host_permissions": [
    "https://meet.google.com/*",
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*",
    "https://aks-online.onrender.com/*",
    "https://*.onrender.com/*"
  ],
  "permissions": ["declarativeNetRequestWithHostAccess", "storage"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "meet_frame_headers",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
